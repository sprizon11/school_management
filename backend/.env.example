DATABASE_URL="postgresql://school:school123@localhost:5432/school_management?schema=public"
JWT_SECRET="change-me-in-production"
# Access-token lifetime. Kept short because refresh tokens carry the session.
JWT_EXPIRES_IN="15m"
# "Continue with Google": comma-separated OAuth client IDs accepted as valid
# audiences (web, Android, iOS). Leave blank to disable Google sign-in.
GOOGLE_CLIENT_IDS=""
SEED_STUDENT_COUNT=250
PORT=3000
# Private dev portal (email/password login for dev-portal website)
DEV_PORTAL_EMAIL="you@example.com"
DEV_PORTAL_PASSWORD="change-me-strong-password"
# Optional legacy API key fallback
DEV_PLATFORM_KEY="change-me-dev-key"
